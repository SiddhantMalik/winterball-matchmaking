<!DOCTYPE html>
<html>
<head>
  <title>Find Your Match | Winterball Date Finder</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <div class="container">
    <nav class="app-nav">
      <a href="/date-finder/swipe" class="active">Swipe</a>
      <a href="/date-finder/matches">Matches</a>
      <a href="/date-finder/edit-profile">Edit Profile</a>
      <a href="/auth/logout" class="logout">Logout</a>
    </nav>
    
    <h1>Find Your Date</h1>
    
    <% if (potentialMatch) { %>
      <div class="swipe-card">
        <h2><%= potentialMatch.name %></h2>
        
        <div class="profile-info">
          <% if (potentialMatch.gender) { %>
            <p class="gender"><%= potentialMatch.gender %></p>
          <% } %>
          <p class="bio"><%= potentialMatch.bio %></p>
        </div>
        
        <div class="interests">
          <% if (potentialMatch.interests && Array.isArray(potentialMatch.interests)) { %>
            <% potentialMatch.interests.forEach(interest => { %>
              <span class="interest-tag"><%= interest %></span>
            <% }) %>
          <% } else { %>
            <p>No interests listed</p>
          <% } %>
        </div>
        
        <div class="swipe-actions">
          <form action="/date-finder/swipe" method="POST">
            <input type="hidden" name="targetId" value="<%= potentialMatch.id %>">
            <input type="hidden" name="action" value="pass">
            <button type="submit" class="btn-pass">Pass</button>
          </form>
          
          <form action="/date-finder/swipe" method="POST">
            <input type="hidden" name="targetId" value="<%= potentialMatch.id %>">
            <input type="hidden" name="action" value="like">
            <button type="submit" class="btn-like">Like</button>
          </form>
        </div>
        
        <div class="swipe-count">
          <%= remainingMatches %> potential matches remaining
        </div>
      </div>
    <% } else { %>
      <div class="no-matches">
        <h2>No more profiles to view</h2>
        <p>Check back later or update your preferences to see more people.</p>
        <a href="/date-finder/matches" class="btn-primary">See Your Matches</a>
      </div>
    <% } %>
  </div>
</body>
</html>